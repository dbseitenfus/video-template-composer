      "duration": 4,
      "volume": 0.8,
      "duckMusic": true
    }
  ],
  "outro": {
    "duration": 3,
    "background": {
      "type": "color",
      "color": "#13235c"
    },
    "layers": [
      {
        "type": "text",
        "text": "Bem-vindo(a) ao time!",
        "x": 0.5,
        "y": 0.45,
        "align": "center",
        "fontSize": 0.08,
        "fontWeight": 800,
        "color": "#ffffff",
        "start": 0,
        "animation": "pop",
        "shadow": true,
        "maxWidth": 0.85
      },
      {
        "type": "image",
        "asset": "logo.svg",
        "x": 0.5,
        "y": 0.65,
        "width": 0.2,
        "start": 0.4,
        "animation": "fade",
        "animationDuration": 0.5
      }
    ]
  },
  "logo": {
    "asset": "logo.svg",
    "position": "bottom-right",
    "width": 0.13,
    "margin": 0.035,
    "opacity": 0.8,
    "showOn": "slots"
  },
  "music": {
    "asset": "trilha-leve.wav",
    "volume": 0.45,
    "duckedVolume": 0.07,
    "fadeIn": 1,
    "fadeOut": 2
  },
  "transition": {
    "type": "fade-black",
    "duration": 0.3
  }
}
