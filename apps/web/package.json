{
  "name": "@takeslot/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "vite build && wrangler d1 migrations apply gravai --local && wrangler pages dev dist --port 8788",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit && tsc -p functions/tsconfig.json",
    "test:e2e": "playwright test",
    "test:e2e:admin": "playwright test -c playwright.admin.config.ts",
    "deploy": "vite build && wrangler d1 migrations apply gravai --remote && wrangler pages deploy dist --branch main",
    "import:videos": "node scripts/import-videos.mjs --manifest scripts/campanha/manifest.json --dir scripts/campanha/arquivos"
  },
  "dependencies": {
    "@takeslot/engine": "0.1.0",
    "@takeslot/schema": "0.1.0",
    "@takeslot/templates": "0.1.0",
    "comlink": "^4.4.2",
    "mediabunny": "^1.62.0",
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "vue-router": "^5.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.4.6",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^1.2.0",
    "vue-tsc": "^3.1.0",
    "wrangler": "^4.152.0"
  }
}
